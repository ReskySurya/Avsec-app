{
    "info": {
        "name": "Avsec API v1",
        "description": "Koleksi API untuk aplikasi mobile Avsec",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000/api/v1",
            "type": "string"
        },
        {
            "key": "token",
            "value": "PASTE_YOUR_TOKEN_HERE",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"login\": \"12345678\",\n    \"password\": \"password123\"\n}",
                            "options": {"raw": {"language": "json"}}
                        },
                        "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
                    }
                },
                {
                    "name": "Get Profile (Me)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"]}
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"]}
                    }
                }
            ]
        },
        {
            "name": "2. Dashboard & History",
            "item": [
                {
                    "name": "Dashboard Summary",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/dashboard", "host": ["{{base_url}}"], "path": ["dashboard"]}
                    }
                },
                {
                    "name": "History",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/history", "host": ["{{base_url}}"], "path": ["history"]}
                    }
                }
            ]
        },
        {
            "name": "3. Master Data",
            "item": [
                {
                    "name": "Get Locations",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/master-data/locations", "host": ["{{base_url}}"], "path": ["master-data", "locations"]}
                    }
                },
                {
                    "name": "Get Equipments",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/master-data/equipments", "host": ["{{base_url}}"], "path": ["master-data", "equipments"]}
                    }
                }
            ]
        },
        {
            "name": "4. Logbook (Pos Jaga)",
            "item": [
                {
                    "name": "Get All Pos Jaga (Draft)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {"raw": "{{base_url}}/logbook/pos-jaga", "host": ["{{base_url}}"], "path": ["logbook", "pos-jaga"]}
                    }
                },
                {
                    "name": "Create Logbook Pos Jaga",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"date\": \"2023-10-25\",\n    \"location_area_id\": 1,\n    \"grup\": \"Grup A\",\n    \"shift\": \"pagi\"\n}",
                            "options": {"raw": {"language": "json"}}
                        },
                        "url": {"raw": "{{base_url}}/logbook/pos-jaga", "host": ["{{base_url}}"], "path": ["logbook", "pos-jaga"]}
                    }
                }
            ]
        }
    ]
}
